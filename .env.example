# Ethereum Mainnet JSON-RPC. A public endpoint is acceptable for a short demo;
# use your own provider for stable/repeated data collection.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
MAINNET_CONFIRMATIONS=12
MAINNET_BLOCKS=120
RPC_BLOCK_CHUNK=20

# Sepolia deployment. Never commit a private key.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# Optional comma-separated seed addresses with a documented public source.
SEED_ADDRESSES=

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

